# SQLite file, created by `npm run db:push`
DATABASE_URL="file:./dev.db"

# AI coach: Google Gemini via OpenRouter (optional). Never commit real keys.
# Set the key with: npm run set-key
OPENROUTER_API_KEY=""
# Any "google/" model on OpenRouter; default google/gemini-3.7-flash
OPENROUTER_MODEL="google/gemini-3.7-flash"

# ─── Deployment only (leave unset for local dev) ─────────────────────────────
# Turso (hosted SQLite). When set, the app uses it instead of the local SQLite file.
# Set these in Vercel's project settings, and in .env.turso for `npm run db:turso`.
# TURSO_DATABASE_URL="libsql://<db>-<org>.turso.io"
# TURSO_AUTH_TOKEN=""
# Vercel Blob (private store) for trade screenshots. Added automatically when you
# connect a Blob store to the Vercel project. Unset = files in uploads/.
# BLOB_READ_WRITE_TOKEN=""
